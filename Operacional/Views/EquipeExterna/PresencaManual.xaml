<UserControl x:Class="Operacional.Views.EquipeExterna.PresencaManual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             Loaded="OnLoaded">
    <DockPanel Margin="8">
        <WrapPanel x:Name="formulario" DockPanel.Dock="Top" Margin="0,0,0,8">
            <StackPanel Width="240" Margin="0,0,8,8">
                <TextBlock Text="Equipe"/>
                <telerik:RadComboBox x:Name="equipe" DisplayMemberPath="equipe_e" SelectedValuePath="id_equipe"
                                     SelectionChanged="OnEquipeChanged"/>
            </StackPanel>
            <StackPanel Width="180" Margin="0,0,8,8">
                <TextBlock Text="Cliente"/>
                <telerik:RadComboBox x:Name="cliente" DisplayMemberPath="cliente" SelectedValuePath="id_aprovado"/>
            </StackPanel>
            <StackPanel Width="240" Margin="0,0,8,8">
                <TextBlock Text="Fase"/>
                <telerik:RadComboBox x:Name="fase"/>
            </StackPanel>
            <StackPanel Width="220" Margin="0,0,8,8">
                <TextBlock Text="Função"/>
                <telerik:RadComboBox x:Name="funcao"/>
            </StackPanel>
            <StackPanel Width="130" Margin="0,0,8,8">
                <TextBlock Text="Data"/>
                <telerik:RadDatePicker x:Name="data"/>
            </StackPanel>
            <StackPanel Width="90" Margin="0,0,8,8">
                <TextBlock Text="Pessoas"/>
                <telerik:RadNumericUpDown x:Name="numeroPessoas" Value="{x:Null}"
                                          Minimum="1" Maximum="2147483647"
                                          SmallChange="1" NumberDecimalDigits="0"/>
            </StackPanel>
            <telerik:RadToggleButton x:Name="extra" Content="Extra" IsChecked="False"
                                     Padding="10,3" VerticalAlignment="Center" Margin="0,0,16,0"/>
            <Button Content="Salvar" Click="OnSalvar" Padding="12,4" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <Button Content="Atualizar" Click="OnAtualizar" Padding="12,4" VerticalAlignment="Center"/>
        </WrapPanel>
        <telerik:RadGridView x:Name="grid" AutoGenerateColumns="True" IsReadOnly="True"
                             CanUserInsertRows="False" CanUserDeleteRows="False"
                             IsFilteringAllowed="True" ShowGroupPanel="False"
                             GroupRenderMode="Flat" ClipboardCopyMode="Cells, Header"/>
    </DockPanel>
</UserControl>
