<UserControl x:Class="Operacional.Views.Despesa.CadastroDespesa"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:telerik="http://schemas.telerik.com/2008/xaml/presentation"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="900" Loaded="UserControl_Loaded">

    <Grid>
        <telerik:RadGridView
            x:Name="dGRelatorio"
            AutoGenerateColumns="False"
            ShowGroupPanel="False"
            CanUserInsertRows="True"
            NewRowPosition="Bottom"
            GroupRenderMode="Flat"
            CanUserDeleteRows="False"
            ItemsSource="{Binding Relatorios}"
            SelectedItem="{Binding Relatorio, Mode=TwoWay}"
            RowValidating="dGRelatorio_RowValidating"
            CellEditEnded="dGRelatorio_CellEditEnded">

            <telerik:RadContextMenu.ContextMenu>
                <telerik:RadContextMenu>
                    <telerik:RadMenuItem Header="Imprimir" Click="OnImprimirRelatorioClick"/>
                </telerik:RadContextMenu>
            </telerik:RadContextMenu.ContextMenu>

            <telerik:RadGridView.Columns>
                <telerik:GridViewDataColumn Header="ID RELATÓRIO" DataMemberBinding="{Binding cod_relatorio}" IsReadOnly="True"/>

                <telerik:GridViewComboBoxColumn
                    Header="FUNCIONÁRIO"
                    UniqueName="codigo_funcionario"
                    DataMemberBinding="{Binding codigo_funcionario}"
                    ItemsSource="{Binding DataContext.Funcionarios, ElementName=Root}"
                    DisplayMemberPath="nome_func"
                    SelectedValueMemberPath="cod_func"
                    Width="300"/>

                <telerik:GridViewComboBoxColumn
                    Header="RELATÓRIO"
                    UniqueName="nome_relatorio"
                    DataMemberBinding="{Binding nome_relatorio}"
                    ItemsSource="{Binding DataContext.DespsRelatorio, ElementName=Root}"
                    DisplayMemberPath="descricao_relatorio"
                    SelectedValueMemberPath="descricao_relatorio"
                    Width="180"/>

                <telerik:GridViewDataColumn Header="LOCALIDADE" DataMemberBinding="{Binding localidade}" Width="160"/>
                <telerik:GridViewDataColumn Header="DATA" DataMemberBinding="{Binding data}" DataFormatString="{}{0:dd/MM/yyyy}"/>

                <telerik:GridViewComboBoxColumn
                    Header="FINANCEIRO"
                    DataMemberBinding="{Binding classif_financeiro}"
                    ItemsSource="{Binding DataContext.ClassFinanceiro, ElementName=Root}"/>

                <telerik:GridViewComboBoxColumn
                    Header="EMPRESA"
                    DataMemberBinding="{Binding codigo_empresa}"
                    ItemsSource="{Binding DataContext.Empresas, ElementName=Root}"
                    DisplayMemberPath="nome_empresa"
                    SelectedValueMemberPath="codigo_empresa"
                    Width="380"/>
            </telerik:RadGridView.Columns>

            <telerik:RadGridView.ChildTableDefinitions>
                <telerik:GridViewTableDefinition/>
            </telerik:RadGridView.ChildTableDefinitions>

            <telerik:RadGridView.HierarchyChildTemplate>
                <DataTemplate>
                    <TabControl Margin="8">
                        <TabItem Header="Observação">
                            <telerik:RadGridView
                                AutoGenerateColumns="False"
                                ShowGroupPanel="False"
                                CanUserInsertRows="False"
                                ItemsSource="{Binding RelatorioObservacao}"
                                RowValidating="dGRelatorioObservacao_RowValidating">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="OBSERVAÇÃO" DataMemberBinding="{Binding observacao}" Width="600" TextWrapping="Wrap"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </TabItem>

                        <TabItem Header="Adiantamento">
                            <telerik:RadGridView
                                AutoGenerateColumns="False"
                                ShowGroupPanel="False"
                                CanUserInsertRows="False"
                                ItemsSource="{Binding RelatorioAdiantamento}"
                                RowValidating="dGRelatorioAdiantamento_RowValidating">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="VALOR ADIANTAMENTO" DataMemberBinding="{Binding valor_adiantamento}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="VALOR DO PESO" DataMemberBinding="{Binding valor_real_peso}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="COTAÇÃO PESO" DataMemberBinding="{Binding valor_cotacao_peso}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="VALOR PESO" DataMemberBinding="{Binding valor_peso_peso}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="VALOR DO US$" DataMemberBinding="{Binding valor_real_dolar}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="COTAÇÃO US$" DataMemberBinding="{Binding valor_cotacao_dolar}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="VALOR US$" DataMemberBinding="{Binding valor_dolar_dolar}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="TOTAL ADIANTAMENTO" DataMemberBinding="{Binding total_adiantamento}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewDataColumn Header="DATA PAGAMENTO" DataMemberBinding="{Binding data_pagamento}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                                    <telerik:GridViewComboBoxColumn Header="FORMA PAGAMENTO" DataMemberBinding="{Binding forma_pagto}" ItemsSource="{Binding DataContext.FormaPagamento, ElementName=Root}"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </TabItem>

                        <TabItem Header="Detalhes">
                            <telerik:RadGridView
                                AutoGenerateColumns="False"
                                ShowGroupPanel="False"
                                CanUserInsertRows="True"
                                NewRowPosition="Bottom"
                                GroupRenderMode="Flat"
                                ItemsSource="{Binding RelatorioDespesaDetalhesEditaveis}"
                                RowValidating="dGRelatorioDetalhes_RowValidating">
                                <telerik:RadGridView.Columns>
                                    <telerik:GridViewDataColumn Header="DATA" DataMemberBinding="{Binding data}" DataFormatString="{}{0:dd/MM/yyyy}"/>
                                    <telerik:GridViewComboBoxColumn Header="SIGLA"
                                                                    DataMemberBinding="{Binding sigla, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding DataContext.Clientes, Source={x:Reference Root}}"
                                                                    DisplayMemberPath="sigla"
                                                                    SelectedValueMemberPath="sigla"/>
                                    <telerik:GridViewDataColumn Header="QTDE" DataMemberBinding="{Binding quantidade}" DataFormatString="{}{0:N2}"/>
                                    <telerik:GridViewComboBoxColumn Header="ETAPA"
                                                                    DataMemberBinding="{Binding etapa, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding DataContext.Fases, Source={x:Reference Root}}"/>
                                    <telerik:GridViewComboBoxColumn Header="CLASSIFICAÇÃO"
                                                                    DataMemberBinding="{Binding classificacao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSource="{Binding DataContext.TiposClassificacao, Source={x:Reference Root}}"/>
                                    <telerik:GridViewComboBoxColumn Header="DESCRIÇÃO"
                                                                    DataMemberBinding="{Binding descricao, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                    ItemsSourceBinding="{Binding DescricoesDisponiveis}"
                                                                    Width="220"/>

                                    <telerik:GridViewDataColumn Header="DOCUMENTO" DataMemberBinding="{Binding documento}"/>
                                    <telerik:GridViewDataColumn Header="VALOR" DataMemberBinding="{Binding valor}" DataFormatString="{}{0:N2}"/>
                                </telerik:RadGridView.Columns>
                            </telerik:RadGridView>
                        </TabItem>
                    </TabControl>
                </DataTemplate>
            </telerik:RadGridView.HierarchyChildTemplate>
        </telerik:RadGridView>
    </Grid>
</UserControl>
